rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Connection test endpoint
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Collection & Subcollections ---
    match /users/{userId} {
      allow read, write: if true;

      // Subcollections for user data (intakeLogs, progressLogs, hydrationLogs, notes, pantryItems, etc.)
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Profiles (alias used in some modules)
    match /profiles/{profileId} {
      allow read, write: if true;
    }

    // Medicinal Herbs (global encyclopedia & user favorites)
    match /medicinalHerbs/{herbId} {
      allow read, write: if true;
    }

    // Recipes (global/saved)
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    // Gym partner centers (academies)
    match /academies/{academyId} {
      allow read, write: if true;
    }

    // Recipe feedback & ratings
    match /recipeReviews/{reviewId} {
      allow read, write: if true;
    }

    // General app feedback & ratings
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Couriers / Delivery drivers
    match /couriers/{courierId} {
      allow read, write: if true;
    }

    // Deliveries telemetry and real-time trackers
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }

    // Smart plate combinations
    match /smartPlateCombinations/{comboId} {
      allow read, write: if true;
    }

    // Pantry, fridge, garden items
    match /pantryItems/{id} {
      allow read, write: if true;
    }
    match /fridgeItems/{id} {
      allow read, write: if true;
    }
    match /gardenItems/{id} {
      allow read, write: if true;
    }

    // Orders & Shopping
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Health logs (Glucose, Blood Pressure, etc.)
    match /glucoseLogs/{id} {
      allow read, write: if true;
    }
    match /bloodPressureLogs/{id} {
      allow read, write: if true;
    }

    // Scanners & Identifiers
    match /plantIdentifications/{id} {
      allow read, write: if true;
    }
    match /mushroomIdentifications/{id} {
      allow read, write: if true;
    }
    match /allergyScans/{id} {
      allow read, write: if true;
    }
    match /productComparisons/{id} {
      allow read, write: if true;
    }

    // Notebook / Notes
    match /notes/{id} {
      allow read, write: if true;
    }

    // Adaptive AI Insights
    match /adaptiveInsights/{id} {
      allow read, write: if true;
    }

    // Global and cross-device button states
    match /buttonStates/{buttonId} {
      allow read, write: if true;
    }
    match /globalButtonStates/{buttonId} {
      allow read, write: if true;
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
