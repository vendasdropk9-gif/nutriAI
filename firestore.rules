rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- User Collection & Subcollections ---
    match /users/{userId} {
      allow get, list, create, update, delete: if isOwner(userId) || request.auth == null;

      // Subcollections for user data (intakeLogs, progressLogs, hydrationLogs, notes, etc.)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId) || request.auth == null;
      }
    }

    // Medicinal Herbs (global encyclopedia)
    match /medicinalHerbs/{herbId} {
      allow read, write: if true;
    }

    // Recipes (global/saved)
    match /recipes/{recipeId} {
      allow read, write: if true;
    }

    // Gym partner centers (academies)
    match /academies/{academyId} {
      allow read, write: if true;
    }

    // Recipe feedback & ratings
    match /recipeReviews/{reviewId} {
      allow read, write: if true;
    }

    // General app feedback & ratings
    match /feedbacks/{feedbackId} {
      allow read, write: if true;
    }

    // Couriers / Delivery drivers
    match /couriers/{courierId} {
      allow read, write: if true;
    }

    // Deliveries telemetry and real-time trackers
    match /deliveries/{deliveryId} {
      allow read, write: if true;
    }
  }
}
