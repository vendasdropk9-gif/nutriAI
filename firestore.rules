rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Security Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isNonNegativeNumber(val) {
      return val is number && val >= 0;
    }

    // Prevents identity spoofing: new document's userId must match auth.uid
    function createsOwnDoc() {
      return !('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid;
    }

    // Prevents shadow update / transferring ownership: userId cannot be changed
    function maintainsOwnership() {
      return !('userId' in resource.data) || (
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.userId == request.auth.uid
      );
    }

    // Prevents privilege escalation and ghost field injection on User document updates
    function isValidUserUpdate() {
      let isUnchangedPoints = !('points' in resource.data) || (
        !('points' in request.resource.data) || request.resource.data.points == resource.data.points
      );
      let isUnchangedRole = !('role' in resource.data) || (
        !('role' in request.resource.data) || request.resource.data.role == resource.data.role
      );
      let isUnchangedVerified = !('isVerified' in resource.data) || (
        !('isVerified' in request.resource.data) || request.resource.data.isVerified == resource.data.isVerified
      );
      let isValidArraySize = !('restrictions' in request.resource.data) || (
        request.resource.data.restrictions is list && request.resource.data.restrictions.size() <= 100
      );
      return isUnchangedPoints && isUnchangedRole && isUnchangedVerified && isValidArraySize;
    }

    // Prevents negative nutrition values
    function isValidNutrition() {
      let hasNutrition = 'nutrition' in request.resource.data;
      return !hasNutrition || (
        request.resource.data.nutrition is map &&
        (!('calories' in request.resource.data.nutrition) || isNonNegativeNumber(request.resource.data.nutrition.calories)) &&
        (!('protein' in request.resource.data.nutrition) || isNonNegativeNumber(request.resource.data.nutrition.protein)) &&
        (!('carbs' in request.resource.data.nutrition) || isNonNegativeNumber(request.resource.data.nutrition.carbs)) &&
        (!('fat' in request.resource.data.nutrition) || isNonNegativeNumber(request.resource.data.nutrition.fat))
      );
    }

    function isValidAdTelemetry() {
      let data = request.resource.data;
      return (!('videoLoads' in data) || isNonNegativeNumber(data.videoLoads)) &&
        (!('bannerLoads' in data) || isNonNegativeNumber(data.bannerLoads)) &&
        (!('videoClicks' in data) || isNonNegativeNumber(data.videoClicks)) &&
        (!('bannerClicks' in data) || isNonNegativeNumber(data.bannerClicks)) &&
        (!('totalImpressions' in data) || isNonNegativeNumber(data.totalImpressions)) &&
        (!('totalClicks' in data) || isNonNegativeNumber(data.totalClicks)) &&
        (!('conversionContext' in data) || (data.conversionContext is string && data.conversionContext.size() <= 100)) &&
        (!('lastAdType' in data) || data.lastAdType in ['Vídeo', 'Banner']) &&
        (!('lastClickedAdType' in data) || data.lastClickedAdType in ['Vídeo', 'Banner']) &&
        (!('lastClickTimestamp' in data) || data.lastClickTimestamp == request.time) &&
        (!('experimentId' in data) || (data.experimentId is string && data.experimentId.size() <= 128)) &&
        (!('abVariant' in data) || data.abVariant in ['A', 'B']) &&
        (!('abVariantStyle' in data) || data.abVariantStyle in ['standard', 'claymorphic']) &&
        (!('visibilityRatio' in data) || (data.visibilityRatio is number && data.visibilityRatio >= 0 && data.visibilityRatio <= 1.0)) &&
        (!('visibilidade_percentual' in data) || (data.visibilidade_percentual is number && data.visibilidade_percentual >= 0 && data.visibilidade_percentual <= 100)) &&
        (!('totalDwellTimeMs' in data) || isNonNegativeNumber(data.totalDwellTimeMs)) &&
        (!('totalDwellTimeSeconds' in data) || isNonNegativeNumber(data.totalDwellTimeSeconds)) &&
        (!('lastDwellTimeMs' in data) || isNonNegativeNumber(data.lastDwellTimeMs)) &&
        (!('byContext' in data) || data.byContext is map) &&
        (!('byVariant' in data) || data.byVariant is map) &&
        (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function isValidAdTelemetryLog() {
      let data = request.resource.data;
      return data.keys().hasAll(['eventType', 'adType', 'format', 'adId', 'placementId', 'conversionContext', 'visibilidade_percentual', 'userId', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['id', 'eventType', 'adType', 'format', 'adId', 'placementId', 'conversionContext', 'visibilityThreshold', 'visibilityRatio', 'visibilidade_percentual', 'dwellTimeMs', 'dwellTimeSeconds', 'dwellFlushReason', 'experimentId', 'abVariant', 'abVariantStyle', 'userId', 'timestamp', 'createdAt']) &&
        data.eventType in ['impression', 'click', 'dwell'] &&
        data.adType in ['Vídeo', 'Banner'] &&
        data.format in ['video', 'banner'] &&
        data.adId is string && data.adId.size() <= 128 &&
        data.placementId is string && data.placementId.size() <= 128 &&
        data.conversionContext is string && data.conversionContext.size() <= 100 &&
        (!('visibilityThreshold' in data) || (data.visibilityThreshold is number && data.visibilityThreshold >= 0.5 && data.visibilityThreshold <= 1.0)) &&
        (!('visibilityRatio' in data) || (data.visibilityRatio is number && data.visibilityRatio >= 0 && data.visibilityRatio <= 1.0)) &&
        data.visibilidade_percentual is number && data.visibilidade_percentual >= 0 && data.visibilidade_percentual <= 100 &&
        (!('dwellTimeMs' in data) || isNonNegativeNumber(data.dwellTimeMs)) &&
        (!('dwellTimeSeconds' in data) || isNonNegativeNumber(data.dwellTimeSeconds)) &&
        (!('dwellFlushReason' in data) || data.dwellFlushReason in ['interval', 'hidden', 'dismiss', 'unmount', 'visibility_exit']) &&
        (data.eventType != 'dwell' || ('dwellTimeMs' in data && data.dwellTimeMs is number && data.dwellTimeMs > 0)) &&
        (!('experimentId' in data) || (data.experimentId is string && data.experimentId.size() <= 128)) &&
        (!('abVariant' in data) || data.abVariant in ['A', 'B']) &&
        (!('abVariantStyle' in data) || data.abVariantStyle in ['standard', 'claymorphic']) &&
        data.userId is string && data.userId == request.auth.uid &&
        data.timestamp == request.time &&
        data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidAdABTest() {
      let data = request.resource.data;
      return data.keys().hasOnly([
        'experimentId',
        'placementId',
        'conversionContext',
        'variants',
        'bestPerformingVariant',
        'winnerByClicks',
        'winnerByVisibility',
        'metricsSummary',
        'updatedAt'
      ]) &&
        (!('experimentId' in data) || (data.experimentId is string && data.experimentId.size() <= 128)) &&
        (!('placementId' in data) || (data.placementId is string && data.placementId.size() <= 128)) &&
        (!('conversionContext' in data) || (data.conversionContext is string && data.conversionContext.size() <= 100)) &&
        (!('variants' in data) || data.variants is map) &&
        (!('bestPerformingVariant' in data) || data.bestPerformingVariant in ['A', 'B', 'tie']) &&
        (!('winnerByClicks' in data) || data.winnerByClicks in ['A', 'B', 'tie']) &&
        (!('winnerByVisibility' in data) || data.winnerByVisibility in ['A', 'B', 'tie']) &&
        (!('metricsSummary' in data) || data.metricsSummary is map) &&
        (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    // --- Connection Test ---
    match /test/connection {
      allow read: if true;
    }

    // --- User Profiles and Subcollections (Strict Isolation) ---
    match /users/{userId} {
      allow read: if isValidId(userId) && isOwner(userId);
      allow create: if isValidId(userId) && isOwner(userId) && createsOwnDoc();
      allow update: if isValidId(userId) && isOwner(userId) && maintainsOwnership() && isValidUserUpdate();
      allow delete: if isValidId(userId) && isOwner(userId);
      
      // Subcollections under /users/{userId}/...
      match /{allSubcollections=**} {
        allow read: if isValidId(userId) && isOwner(userId);
        allow create: if isValidId(userId) && isOwner(userId) && createsOwnDoc() && isValidNutrition();
        allow update: if isValidId(userId) && isOwner(userId) && maintainsOwnership() && isValidNutrition();
        allow delete: if isValidId(userId) && isOwner(userId);
      }
    }

    // --- Legacy / Alternative Profile Path ---
    match /profiles/{profileId} {
      allow read, write: if isValidId(profileId) && isOwner(profileId);
    }

    // --- Pantry & Fridge Items (Scoped by User) ---
    match /pantryItems/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && createsOwnDoc();
      allow update: if isSignedIn() && isValidId(id) && isOwner(resource.data.userId) && maintainsOwnership();
      allow delete: if isSignedIn() && isValidId(id) && isOwner(resource.data.userId);
    }

    match /fridgeItems/{id} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && createsOwnDoc();
      allow update: if isSignedIn() && isValidId(id) && isOwner(resource.data.userId) && maintainsOwnership();
      allow delete: if isSignedIn() && isValidId(id) && isOwner(resource.data.userId);
    }

    // --- Recipes (Public Read, Owner Write, Author Ownership Check) ---
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(recipeId) &&
        ('authorId' in request.resource.data && request.resource.data.authorId == request.auth.uid) &&
        isValidNutrition();
      allow update: if isSignedIn() && isValidId(recipeId) &&
        (resource.data.authorId == request.auth.uid) &&
        (request.resource.data.authorId == resource.data.authorId) &&
        isValidNutrition();
      allow delete: if isSignedIn() && isValidId(recipeId) && resource.data.authorId == request.auth.uid;
    }

    // --- Recipe Reviews & Feedbacks ---
    match /recipeReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(reviewId) && createsOwnDoc();
      allow update, delete: if isSignedIn() && isValidId(reviewId) && isOwner(resource.data.userId) && maintainsOwnership();
    }

    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(feedbackId) && createsOwnDoc();
      allow update, delete: if isSignedIn() && isValidId(feedbackId) && isOwner(resource.data.userId) && maintainsOwnership();
    }

    // --- Presence ---
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isValidId(userId) && isOwner(userId);
    }

    // --- Medicinal Herbs & Academies ---
    match /medicinalHerbs/{herbId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /academies/{academyId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(academyId);
      allow delete: if false;
    }

    // --- Orders & Deliveries (Owner & Courier Access) ---
    match /orders/{orderId} {
      allow read: if isSignedIn() && isValidId(orderId) && (
        !('userId' in resource.data) || resource.data.userId == request.auth.uid
      );
      allow create: if isSignedIn() && isValidId(orderId) && createsOwnDoc();
      allow update: if isSignedIn() && isValidId(orderId) && (
        isOwner(resource.data.userId) || !('userId' in resource.data)
      );
      allow delete: if false;
    }

    match /couriers/{courierId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(courierId);
    }

    match /deliveries/{deliveryId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(deliveryId);
      allow delete: if false;
    }

    // --- Button States ---
    match /buttonStates/{buttonId} {
      allow read, write: if isSignedIn() && isValidId(buttonId);
    }

    // --- Mail (Outgoing Emails - Create Only) ---
    match /mail/{mailId} {
      allow create: if isSignedIn() && isValidId(mailId);
      allow read, update, delete: if false;
    }

    // --- Ad Telemetry ---
    match /adTelemetry/{telemetryId} {
      allow read: if isSignedIn() && isValidId(telemetryId);
      allow create, update: if isSignedIn() && isValidId(telemetryId) && isValidAdTelemetry();
      allow delete: if false;
    }

    match /adTelemetryLogs/{logId} {
      allow get: if isSignedIn() && isValidId(logId) && resource.data.userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(logId) && isValidAdTelemetryLog();
      allow update, delete: if false;
    }

    match /adABTests/{experimentId} {
      allow read: if isSignedIn() && isValidId(experimentId);
      allow create, update: if isSignedIn() && isValidId(experimentId) && isValidAdABTest();
      allow delete: if false;
    }

    // Catch-All Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
