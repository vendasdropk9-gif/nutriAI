rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Daily Logs Validation Helpers ---
    function isValidUser(u) {
      return u.keys().hasAll(['createdAt', 'updatedAt']) &&
             u.createdAt == request.time &&
             u.updatedAt == request.time;
    }

    function isValidUserUpdate(u, ext) {
      return u.updatedAt == request.time;
    }

    function isValidLog(l) {
      return l.userId == request.auth.uid &&
             l.date is string && l.date.size() <= 100 &&
             l.createdAt == request.time;
    }

    // --- Match Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUserUpdate(incoming(), existing());

      // Subcollections for meals & nutrition history
      match /intakeLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().recipeName is string;
        allow delete: if isOwner(userId);
      }

      // Subcollections for biological weights & photos
      match /progressLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().weight is number;
        allow delete: if isOwner(userId);
      }

      // Subcollections for cups/liters hydration logs
      match /hydrationLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().amount is number;
        allow delete: if isOwner(userId);
      }

      // Subcollections for sleep log records
      match /sleepLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().durationHours is number && incoming().quality is string;
        allow delete: if isOwner(userId);
      }

      // Subcollections for mood / humor logs
      match /emotionalLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().mood is string;
        allow delete: if isOwner(userId);
      }

      // Subcollections for intermittent fasting logs
      match /fastingLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming()) && incoming().durationHours is number;
        allow delete: if isOwner(userId);
      }

      // Subcollections for physical training workouts
      match /workoutLogs/{logId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidLog(incoming());
        allow delete: if isOwner(userId);
      }

      // Subcollections for notifications histories
      match /notifications/{notifId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().createdAt == request.time && incoming().title is string;
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read']);
        allow delete: if isOwner(userId);
      }

      // AI Chats
      match /aiChats/{chatId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().createdAt == request.time && incoming().updatedAt == request.time && incoming().messages is list;
        allow update: if isOwner(userId) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['messages', 'preferencesLearned', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Marketplace orders
      match /orders/{orderId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && incoming().createdAt == request.time && incoming().updatedAt == request.time && incoming().status == 'pending' && incoming().storeId is string && incoming().items is list;
        allow update: if isOwner(userId) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      }

      // Adaptive coach insights
      match /adaptiveInsights/{insightId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && 
                      incoming().userId == request.auth.uid &&
                      incoming().date is string &&
                      incoming().createdAt == request.time &&
                      incoming().status == 'pending';
        allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      }
    }

    // Recipes (global/saved)
    match /recipes/{recipeId} {
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && 
                    incoming().keys().hasAll(['name', 'ingredients', 'instructions', 'authorId', 'createdAt', 'updatedAt']) &&
                    incoming().authorId == request.auth.uid &&
                    incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && existing().authorId == request.auth.uid &&
                    incoming().authorId == request.auth.uid &&
                    incoming().createdAt == existing().createdAt &&
                    incoming().updatedAt == request.time &&
                    incoming().diff(existing()).affectedKeys().hasOnly([
                      'name', 'description', 'prepTime', 'ingredients', 'instructions', 'nutrition', 'isPublic', 'updatedAt'
                    ]);
      allow delete: if isSignedIn() && existing().authorId == request.auth.uid;
    }

    // Gym partner centers (academies)
    match /academies/{academyId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Couriers / Delivery drivers
    match /couriers/{courierId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Deliveries telemetry and real-time trackers
    match /deliveries/{deliveryId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        resource.data.courierId == request.auth.uid ||
        resource.data.userId == 'anonymous'
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        incoming().diff(existing()).affectedKeys().hasAny([
          'status', 'progress', 'currentLat', 'currentLng', 'etaMinutes', 'notifications', 'rating', 'reviewText', 'updatedAt'
        ])
      );
    }
  }
}
