rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helpers ---
    function isSignedIn() { return request.auth != null; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    
    // --- Connection Test ---
    match /test/connection {
      allow read: if true;
    }

    // --- User Collections (Strictly Secured to Owner) ---
    match /users/{userId} {
      // Allow access if owner, OR if user is a guest (for direct access scenarios)
      allow read, write: if isValidId(userId) && (isOwner(userId) || userId == 'guest-direct-user');
      
      // Subcollections (Secured to owner or guest)
      match /{allSubcollections=**} {
        allow read, write: if isValidId(userId) && (isOwner(userId) || userId == 'guest-direct-user');
      }
    }

    // --- Pantry & Fridge Items (Explicit collection rules - Restricted to Auth) ---
    // Note: These collections lack a userId field in their schema, preventing strict ownership enforcement.
    match /pantryItems/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }
    match /fridgeItems/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // --- Profiles (Shared/Public read-only, unless it's the owner profile) ---
    match /profiles/{profileId} {
      allow read: if isSignedIn();
      allow write: if isValidId(profileId) && isOwner(profileId);
    }

    // --- Global / Public Collections (Read-only for signed-in users) ---
    match /medicinalHerbs/{herbId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
    match /recipes/{recipeId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }
    match /academies/{academyId} {
      allow read: if isSignedIn();
      allow write: if false; 
    }

    // --- Application Data & Interaction Collections ---
    match /recipeReviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId);
    }
    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isOwner(resource.data.userId);
    }
    match /buttonStates/{buttonId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }
    match /presence/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);
    }

    // Default Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
